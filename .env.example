ENVIRONMENT=development
# Generate with: openssl rand -hex 32. The app refuses missing/short secrets.
JWT_SECRET=
# Local Compose defaults. URL-encode special characters in credentials.
DATABASE_URL=postgresql+asyncpg://lustcode:lustcode@localhost:5432/lustcode
DATABASE_SSL=false
# For Supabase: direct or SESSION pooler URL (port 5432) with DATABASE_SSL=true.
# Use a direct/session connection for migrations. Transaction pooler is not supported.
# sslmode=require/verify-full is normalized to verified TLS for asyncpg.
# For a private Supabase CA, add a URL-encoded sslrootcert=/path/to/root.crt.
# Container override (takes precedence over a native sslrootcert URL path):
# DATABASE_SSL_ROOT_CERT=/srv/lustcode/certs/supabase-root-2021.crt
# MIGRATION_DATABASE_URL=postgresql+asyncpg://...
# Hosted Compose mode (leave commented for the local PostgreSQL service):
# COMPOSE_FILE=compose.yaml:compose.supabase.yaml
# DOCKER_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=%2Fsrv%2Flustcode%2Fcerts%2Fsupabase-root-2021.crt
# DOCKER_MIGRATION_DATABASE_URL=...  # optional; defaults to DOCKER_DATABASE_URL
# DOCKER_READINESS_TIMEOUT_SECONDS=8
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_COMMAND_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=3
READINESS_TIMEOUT_SECONDS=2
CORS_ORIGINS=["http://localhost:3000"]
# Explicitly opt in to all origins; cross-origin cookie credentials stay disabled.
CORS_ALLOW_ALL_ORIGINS=false
# Empty by default: forwarded identity/scheme headers are ignored.
TRUSTED_PROXY_NETWORKS=[]
TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
PASSWORD_HASH_CONCURRENCY=2
AVATAR_PROCESSING_CONCURRENCY=2
JUDGE0_URL=https://ce.judge0.com
# Optional, only for an instance requiring authentication:
# JUDGE0_AUTH_TOKEN=
# JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_MAX_CONNECTIONS=20
JUDGE0_MAX_KEEPALIVE_CONNECTIONS=10
DAILY_SUBMISSIONS=100
DAILY_TEST_EXECUTIONS=1000
MAX_PENDING_SUBMISSIONS=5
# Native storage path; Compose persists the same relative path in avatar_data.
AVATAR_STORAGE_DIR=var/avatars
AVATAR_MAX_BYTES=262144
